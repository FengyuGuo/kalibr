#!/usr/bin/env python
"""Convert Kalibr omni-radtan camera YAML to pinhole-equidistant YAML."""

from __future__ import print_function

import argparse
import os
import sys
import tempfile

import yaml

from omni_radtan_to_pinhole_equi import (
    convert_configuration,
    plot_projection_changes,
)


def _arguments():
    parser = argparse.ArgumentParser(
        description=(
            "Fit pinhole-equidistant intrinsics to one or more omni-radtan "
            "cameras using least-squares pixel error over spherical-cap rays."))
    parser.add_argument("--input", "-i", required=True,
                        help="input Kalibr camera/camchain YAML")
    parser.add_argument("--output", "-o", required=True,
                        help="output YAML (must differ from input)")
    parser.add_argument(
        "--camera", help="camchain key to convert (for example cam0); "
        "default: convert every omni-radtan camera")
    parser.add_argument(
        "--samples", type=int, default=50000,
        help="uniform solid-angle spherical-cap candidates (default: 50000)")
    parser.add_argument(
        "--max-angle-deg", type=float, default=90.0,
        help="spherical-cap half angle in (0, 180) degrees (default: 90)")
    parser.add_argument(
        "--max-nfev", type=int, default=200,
        help="maximum least-squares function evaluations (default: 200)")
    parser.add_argument(
        "--visualize", action="store_true",
        help="show a before/after projection plot")
    parser.add_argument(
        "--plot-output",
        help="save the before/after projection plot to this image file")
    parser.add_argument(
        "--visualization-points", type=int, default=250,
        help="maximum number of projection pairs shown (default: 250)")
    return parser.parse_args()


def _atomic_write_yaml(path, configuration):
    directory = os.path.dirname(os.path.abspath(path))
    if not os.path.isdir(directory):
        raise ValueError("output directory does not exist: {}".format(directory))
    descriptor, temporary_path = tempfile.mkstemp(
        prefix=".kalibr-camera-", suffix=".yaml.tmp", dir=directory)
    try:
        with os.fdopen(descriptor, "w") as stream:
            yaml.safe_dump(configuration, stream, default_flow_style=None)
        # Kalibr still supports ROS Kinetic/Python 2, where os.replace is not
        # available. On the supported POSIX platforms rename is atomic and
        # replaces an existing regular file.
        os.rename(temporary_path, path)
    except Exception:
        try:
            os.unlink(temporary_path)
        except OSError:
            pass
        raise


def main():
    arguments = _arguments()
    if os.path.abspath(arguments.input) == os.path.abspath(arguments.output):
        print("error: input and output paths must differ", file=sys.stderr)
        return 2
    if (arguments.plot_output and
            os.path.abspath(arguments.plot_output) in
            (os.path.abspath(arguments.input),
             os.path.abspath(arguments.output))):
        print("error: plot output must differ from YAML paths", file=sys.stderr)
        return 2
    if arguments.max_nfev < 1:
        print("error: --max-nfev must be positive", file=sys.stderr)
        return 2
    if arguments.visualization_points < 1:
        print("error: --visualization-points must be positive", file=sys.stderr)
        return 2
    if arguments.max_angle_deg > 90.0:
        print(
            "warning: rays beyond 90 degrees participate in fitting, but "
            "Kalibr pinhole projection treats z <= 0 rays as not visible",
            file=sys.stderr)

    try:
        with open(arguments.input, "r") as stream:
            configuration = yaml.safe_load(stream)
        converted, reports = convert_configuration(
            configuration, camera_name=arguments.camera,
            sample_count=arguments.samples,
            max_angle_degrees=arguments.max_angle_deg,
            max_function_evaluations=arguments.max_nfev)
        _atomic_write_yaml(arguments.output, converted)
        if arguments.visualize or arguments.plot_output:
            pairs = []
            for label in reports:
                if "camera_model" in configuration:
                    source_camera = configuration
                    converted_camera = converted
                else:
                    source_camera = configuration[label]
                    converted_camera = converted[label]
                pairs.append((label, source_camera, converted_camera))
            plot_projection_changes(
                pairs, candidate_count=arguments.samples,
                max_angle_degrees=arguments.max_angle_deg,
                display_count=arguments.visualization_points,
                output_path=arguments.plot_output, show=arguments.visualize)
    except (ImportError, IOError, OSError, RuntimeError, TypeError, ValueError,
            yaml.YAMLError) as error:
        print("error: {}".format(error), file=sys.stderr)
        return 1

    for camera, report in reports.items():
        print("{}: {} / {} valid spherical-cap samples".format(
            camera, report["valid_samples"], report["candidate_samples"]))
        print("  pixel error: RMS={:.6f}, mean={:.6f}, p95={:.6f}, max={:.6f}".format(
            report["rms_pixels"], report["mean_pixels"],
            report["p95_pixels"], report["max_pixels"]))
        print("  SSE={:.6f} px^2, function evaluations={}".format(
            report["sse_pixels_squared"], report["function_evaluations"]))
    print("wrote {}".format(arguments.output))
    if arguments.plot_output:
        print("wrote {}".format(arguments.plot_output))
    return 0


if __name__ == "__main__":
    sys.exit(main())
